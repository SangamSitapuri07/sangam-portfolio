{
  "name": "sangam-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cinematic, scroll-driven 3D developer portfolio — React, Vite, Three.js, React Three Fiber, GSAP ScrollTrigger, Lenis.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\"",
    "model:optimize": "node tools/optimize-model.mjs",
    "verify:rig": "node tools/verify-rig.mjs",
    "og": "node tools/generate-og.mjs",
    "verify:content": "node tools/verify-content.mjs",
    "verify": "npm run verify:content && npm run verify:rig && npm run verify:dom",
    "verify:dom": "node tools/verify-dom.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
