{
  "name": "sangam-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/prerender.mjs && node scripts/verify-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "assets:render": "node scripts/capture-studio.mjs",
    "check": "npm run lint && npm test && npm run build",
    "assets:optimize": "node scripts/optimize-model.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.4.0",
    "meshoptimizer": "^1.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.4"
  }
}
